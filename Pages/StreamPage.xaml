<Page
    x:Class="moonlight_xbox_dx.StreamPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:moonlight_xbox_dx"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    mc:Ignorable="d"
    Background="#07060D"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.Resources>
        <local:BoolToTextConverter x:Key="BoolToTextConverter" TrueText="On" FalseText="Off" />
        <CubicEase x:Key="Out" EasingMode="EaseOut" />

        <!-- Cartouche's buttons: a white pill for the main one, glass for the other. -->
        <Style x:Key="CartoucheButton" TargetType="Button">
            <Setter Property="FontFamily" Value="ms-appx:///Assets/Fonts/Onest.ttf#Onest" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Padding" Value="30,13" />
            <Setter Property="CornerRadius" Value="26" />
            <Setter Property="Background" Value="#24FFFFFF" />
            <Setter Property="Foreground" Value="#F3F0FF" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualPrimaryBrush" Value="#F3F0FF" />
            <Setter Property="FocusVisualPrimaryThickness" Value="3" />
            <Setter Property="FocusVisualSecondaryThickness" Value="0" />
            <Setter Property="FocusVisualMargin" Value="-5" />
        </Style>
        <Style x:Key="CartouchePrimary" TargetType="Button" BasedOn="{StaticResource CartoucheButton}">
            <Setter Property="Background" Value="#F3F0FF" />
            <Setter Property="Foreground" Value="#0C0A16" />
            <Setter Property="BorderBrush" Value="#F3F0FF" />
        </Style>

        <!-- The in-game menu's buttons: glass tiles, a gold edge and a slight lift under the controller. -->
        <Style x:Key="MenuTile" TargetType="Button">
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Foreground" Value="#F3F0FF" />
            <Setter Property="FontFamily" Value="ms-appx:///Assets/Fonts/Onest.ttf#Onest" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" CornerRadius="16" Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1.5" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Zoom" />
                            </Grid.RenderTransform>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#4D8B5CF6" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#338B5CF6" />
                                            <Setter Target="Root.BorderBrush" Value="#F2C14E" />
                                        </VisualState.Setters>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.16" />
                                            <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="PointerFocused" />
                                    <VisualState x:Name="Unfocused" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MenuPrimary" TargetType="Button">
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Foreground" Value="#0C0A16" />
            <Setter Property="FontFamily" Value="ms-appx:///Assets/Fonts/Onest.ttf#Onest" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" CornerRadius="16" Background="#F3F0FF" BorderBrush="#F3F0FF" BorderThickness="1.5" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Zoom" />
                            </Grid.RenderTransform>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#E2DCFA" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#FFFFFF" />
                                            <Setter Target="Root.BorderBrush" Value="#F2C14E" />
                                        </VisualState.Setters>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.16" />
                                            <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="PointerFocused" />
                                    <VisualState x:Name="Unfocused" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Storyboard x:Name="MenuIn">
            <DoubleAnimation Storyboard.TargetName="Menu" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" />
            <DoubleAnimation Storyboard.TargetName="MenuShift" Storyboard.TargetProperty="X" From="120" To="0" Duration="0:0:0.38" EasingFunction="{StaticResource Out}" />
        </Storyboard>
        <Storyboard x:Name="MenuOut">
            <DoubleAnimation Storyboard.TargetName="Menu" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
            <DoubleAnimation Storyboard.TargetName="MenuShift" Storyboard.TargetProperty="X" To="80" Duration="0:0:0.2" />
        </Storyboard>

        <!-- The launch: the cover slides in, the title rises, a light runs along the bar. -->
        <Storyboard x:Name="LaunchIn">
            <DoubleAnimation Storyboard.TargetName="Backdrop" Storyboard.TargetProperty="Opacity" From="0" To="0.34" Duration="0:0:1.2" EasingFunction="{StaticResource Out}" />
            <DoubleAnimation Storyboard.TargetName="CoverCard" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.7" EasingFunction="{StaticResource Out}" />
            <DoubleAnimation Storyboard.TargetName="CoverShift" Storyboard.TargetProperty="X" From="-40" To="0" Duration="0:0:0.8" EasingFunction="{StaticResource Out}" />
            <DoubleAnimation Storyboard.TargetName="Info" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.2" Duration="0:0:0.7" EasingFunction="{StaticResource Out}" />
            <DoubleAnimation Storyboard.TargetName="InfoShift" Storyboard.TargetProperty="Y" From="16" To="0" BeginTime="0:0:0.2" Duration="0:0:0.7" EasingFunction="{StaticResource Out}" />
        </Storyboard>
        <Storyboard x:Name="LaunchRun" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="RunShift" Storyboard.TargetProperty="X" From="-120" To="420" Duration="0:0:1.4" />
            <DoubleAnimation Storyboard.TargetName="GlowScale" Storyboard.TargetProperty="ScaleX" From="1" To="1.1" AutoReverse="True" Duration="0:0:1.8" EasingFunction="{StaticResource Out}" />
            <DoubleAnimation Storyboard.TargetName="GlowScale" Storyboard.TargetProperty="ScaleY" From="1" To="1.1" AutoReverse="True" Duration="0:0:1.8" EasingFunction="{StaticResource Out}" />
        </Storyboard>
        <Storyboard x:Name="LaunchOut">
            <DoubleAnimation Storyboard.TargetName="ProgressView" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.45" EasingFunction="{StaticResource Out}" />
        </Storyboard>
    </Page.Resources>

    <Grid>
        <SwapChainPanel x:Name="swapChainPanel" Margin="{x:Bind State.ScreenMargin}">
            <StackPanel HorizontalAlignment="Stretch" x:Name="KeyboardView" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="64,0,64,16" Padding="8,8,8,8">
                <StackPanel.Background>
                    <SolidColorBrush Color="{ThemeResource SystemColorBackgroundColor}" Opacity="0.75" />
                </StackPanel.Background>
                <local:KeyboardControl OnKeyDown="Keyboard_OnKeyDown" OnKeyUp="Keyboard_OnKeyUp" x:Name="Keyboard"/>
            </StackPanel>
            <Button Click="flyoutButton_Click" IsTabStop="False" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20" x:Name="flyoutButton" AllowFocusOnInteraction="false" Grid.Column="1" Opacity="0">
                <FlyoutBase.AttachedFlyout>
                    <MenuFlyout x:Name="ActionsFlyout" Closed="ActionsFlyout_Closed" AllowFocusOnInteraction="false" Placement="TopEdgeAlignedRight">
                        <MenuFlyoutItem x:Name="toggleMouseButton" Text="{x:Bind MouseMode, Mode=OneWay, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Quitter le mode souris|Mode souris'}" Click="toggleMouseButton_Click" AllowFocusOnInteraction="false" FocusVisualSecondaryThickness="0.5" >
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE962;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="showKeyboardButton" Text="Clavier" Click="showKeyboardButton_Click" AllowFocusOnInteraction="false" FocusVisualSecondaryThickness="0.5" >
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE92E;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSubItem Text="Autres actions">
                            <MenuFlyoutItem x:Name="guideButtonShort" Text="Bouton Xbox (appui court)" Click="guideButtonShort_Click" AllowFocusOnInteraction="false" FocusVisualSecondaryThickness="0.5" >
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xe80f;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="guideButtonLong" Text="Bouton Xbox (appui long)" Click="guideButtonLong_Click" AllowFocusOnInteraction="false" FocusVisualSecondaryThickness="0.5" >
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xe80f;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="toggleHDR_WinAltB" Text="HDR du PC (Win+Alt+B)" Click="toggleHDR_WinAltB_Click" AllowFocusOnInteraction="false" FocusVisualSecondaryThickness="0.5" >
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xe706;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="resetDecoder" Text="Relancer le décodeur" Click="resetDecoder_Click" AllowFocusOnInteraction="false" FocusVisualSecondaryThickness="0.5" >
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE72C;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="toggleFramePacing" Text="Changer le rythme des images" Click="toggleFramePacing_Click" AllowFocusOnInteraction="false" FocusVisualSecondaryThickness="0.5" >
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B9;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator></MenuFlyoutSeparator>
                        <MenuFlyoutItem x:Name="toggleStatsButton" Text="{x:Bind ShowStats, Mode=OneWay, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Masquer les statistiques|Statistiques'}" AllowFocusOnInteraction="false" FocusVisualSecondaryThickness="0.5" Click="toggleStatsButton_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xEC48;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="toggleLogsButton" Text="{x:Bind ShowLogs, Mode=OneWay, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Masquer le journal|Journal'}" AllowFocusOnInteraction="false" Click="toggleLogsButton_Click"  FocusVisualSecondaryThickness="0.5" >
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xF0B5;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator></MenuFlyoutSeparator>

                        <MenuFlyoutSubItem Text="Son">
                            <MenuFlyoutSubItem.Icon>
                                <FontIcon Glyph="&#xF61F;" />
                            </MenuFlyoutSubItem.Icon>
                            <MenuFlyoutItem x:Name="audioBufferSliderItem" AllowFocusOnInteraction="True" IsTabStop="True" UseSystemFocusVisuals="False" PreviewKeyDown="audioBufferSliderItem_PreviewKeyDown">
                                <MenuFlyoutItem.Template>
                                    <ControlTemplate TargetType="MenuFlyoutItem">
                                        <StackPanel Width="340" Padding="12,8" Spacing="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Tampon audio" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Value, ElementName=audioBufferSlider}" />
                                                    <TextBlock Text=" ms" />
                                                </StackPanel>
                                            </Grid>
                                            <Slider x:Name="audioBufferSlider" Minimum="10" Maximum="50" StepFrequency="10"
                                                TickFrequency="10" TickPlacement="BottomRight" SnapsTo="StepValues" SmallChange="10" LargeChange="10"
                                                IsTabStop="False" Loaded="audioBufferSlider_Loaded" ValueChanged="audioBufferSlider_ValueChanged" />
                                            <Grid Margin="5,-2,5,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition />
                                                    <ColumnDefinition />
                                                    <ColumnDefinition />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="10ms" HorizontalAlignment="Left" />
                                                <TextBlock Grid.Column="1" Text="20ms" HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="30ms" HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="40ms" HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="50ms" HorizontalAlignment="Right" />
                                            </Grid>
                                            <TextBlock FontSize="12px" Text="Plus il est petit, plus le son risque de grésiller." VerticalAlignment="Center" />
                                            <TextBlock x:Name="audioGlitchText" FontSize="12px" VerticalAlignment="Center" Loaded="audioGlitchText_Loaded" Text="Glitches: 0 / Drops to reduce latency: 0" />
                                        </StackPanel>
                                    </ControlTemplate>
                                </MenuFlyoutItem.Template>
                            </MenuFlyoutItem>
                        </MenuFlyoutSubItem>

                        <MenuFlyoutItem x:Name="toggleCapture" Text="{x:Bind CaptureMode, Mode=OneWay, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Stop Frame Capture|Start Frame Capture'}" Click="toggleCapture_Click" Visibility="Collapsed" AllowFocusOnInteraction="false" FocusVisualSecondaryThickness="0.5" >
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xF7EE;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutSeparator></MenuFlyoutSeparator>
                        <MenuFlyoutItem x:Name="disonnectButton" Text="Revenir à Cartouche (le jeu continue)" Click="disonnectButton_Click" AllowFocusOnInteraction="false" FocusVisualSecondaryThickness="0.5" >
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE72D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="disconnectAndCloseButton" Text="Quitter le jeu" Click="disconnectAndCloseButton_Click" AllowFocusOnInteraction="false" FocusVisualSecondaryThickness="0.5" >
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE71A;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </FlyoutBase.AttachedFlyout>
            </Button>
        </SwapChainPanel>
        <!-- Launching a game, in Cartouche's look: its cover, its name, the PC, the stages. -->
        <Grid x:Name="ProgressView" Background="#07060D">
            <Image x:Name="Backdrop" Stretch="UniformToFill" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#F507060D" Offset="0" />
                        <GradientStop Color="#C407060D" Offset="0.5" />
                        <GradientStop Color="#7007060D" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0007060D" Offset="0.45" />
                        <GradientStop Color="#FF07060D" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Ellipse Width="980" Height="980" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-260,0,0,0" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="GlowScale" />
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <media:RadialGradientBrush>
                        <GradientStop Color="#594C1D95" Offset="0" />
                        <GradientStop Color="#263B0A8C" Offset="0.5" />
                        <GradientStop Color="#0007060D" Offset="1" />
                    </media:RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" ColumnSpacing="54" Margin="96,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="CoverCard" Width="244" Height="345" CornerRadius="20" Opacity="0" Background="#1A1530" BorderBrush="#40FFFFFF" BorderThickness="1">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="CoverShift" />
                    </Border.RenderTransform>
                    <Image x:Name="Cover" Stretch="UniformToFill" />
                </Border>
                <StackPanel x:Name="Info" Grid.Column="1" VerticalAlignment="Center" Spacing="16" MaxWidth="600" Opacity="0">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="InfoShift" />
                    </StackPanel.RenderTransform>
                    <TextBlock x:Name="Kicker" Text="LANCEMENT" FontFamily="ms-appx:///Assets/Fonts/Onest.ttf#Onest" FontWeight="Bold" FontSize="14" CharacterSpacing="240" Foreground="#F2C14E" />
                    <TextBlock x:Name="GameTitle" FontFamily="ms-appx:///Assets/Fonts/Unbounded.ttf#Unbounded" FontWeight="SemiBold" FontSize="42" LineHeight="50" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Foreground="#F3F0FF" />
                    <TextBlock x:Name="StatusText" Text="" FontFamily="ms-appx:///Assets/Fonts/Onest.ttf#Onest" FontSize="19" Foreground="#C9C2E6" TextWrapping="Wrap" />
                    <Grid x:Name="Bar" Width="400" Height="4" CornerRadius="2" HorizontalAlignment="Left" Background="#1FFFFFFF" Margin="0,6,0,0">
                        <Grid.Clip>
                            <RectangleGeometry Rect="0,0,400,4" />
                        </Grid.Clip>
                        <Rectangle x:Name="BarFill" RadiusX="2" RadiusY="2" RenderTransformOrigin="0,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform x:Name="BarScale" ScaleX="0.04" />
                            </Rectangle.RenderTransform>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop x:Name="BarFrom" Color="#FFB794FF" Offset="0" />
                                    <GradientStop x:Name="BarTo" Color="#FFF2C14E" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle Width="120" Height="4" HorizontalAlignment="Left">
                            <Rectangle.RenderTransform>
                                <TranslateTransform x:Name="RunShift" X="-120" />
                            </Rectangle.RenderTransform>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00FFFFFF" Offset="0" />
                                    <GradientStop Color="#99FFFFFF" Offset="0.6" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                    <TextBlock x:Name="StepText" Text="" FontFamily="ms-appx:///Assets/Fonts/Onest.ttf#Onest" FontSize="13" Foreground="#7F78A0" TextWrapping="Wrap" />
                    <StackPanel x:Name="FailActions" Orientation="Horizontal" Spacing="14" Margin="0,10,0,0" Visibility="Collapsed">
                        <Button x:Name="FailBack" Content="Revenir à Cartouche" Style="{StaticResource CartouchePrimary}" Click="FailBack_Click" />
                        <Button x:Name="FailLogs" Content="Voir le journal" Style="{StaticResource CartoucheButton}" Click="FailLogs_Click" />
                    </StackPanel>
                    <TextBlock x:Name="FailLog" Visibility="Collapsed" FontFamily="Consolas" FontSize="12" Foreground="#9A93BD" TextWrapping="Wrap" MaxHeight="220" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="LaunchHint" Text="En jeu, Vue + Menu ouvre le menu du stream" FontFamily="ms-appx:///Assets/Fonts/Onest.ttf#Onest" FontSize="14" Foreground="#7F78A0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,64,40" />
            <muxc:ProgressRing x:Name="MainProgressRing" Visibility="Collapsed" IsActive="False" />
        </Grid>

        <!-- The in-game menu (View + Menu), drawn by Cartouche: the game, the way out, the tools. -->
        <Grid x:Name="Menu" Visibility="Collapsed" Opacity="0">
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#33000000" Offset="0" />
                        <GradientStop Color="#B3000000" Offset="0.55" />
                        <GradientStop Color="#E6000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Grid HorizontalAlignment="Right" Width="620">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="MenuShift" />
                </Grid.RenderTransform>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#F7171330" Offset="0" />
                            <GradientStop Color="#F70C0A18" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Width="1" HorizontalAlignment="Left" Fill="#4DB794FF" />
                <Ellipse Width="520" Height="520" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-260,-180,0">
                    <Ellipse.Fill>
                        <media:RadialGradientBrush>
                            <GradientStop Color="#404C1D95" Offset="0" />
                            <GradientStop Color="#00171330" Offset="1" />
                        </media:RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <ScrollViewer VerticalScrollBarVisibility="Hidden" Padding="40,36,40,28">
                    <StackPanel Spacing="18" XYFocusKeyboardNavigation="Enabled">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="64" Height="90" CornerRadius="10" BorderBrush="#40FFFFFF" BorderThickness="1" Background="#1A1530">
                                <Image x:Name="MenuCover" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                <TextBlock x:Name="MenuKicker" FontFamily="ms-appx:///Assets/Fonts/Onest.ttf#Onest" FontWeight="Bold" FontSize="12" CharacterSpacing="220" Foreground="#F2C14E" />
                                <TextBlock x:Name="MenuTitle" FontFamily="ms-appx:///Assets/Fonts/Unbounded.ttf#Unbounded" FontWeight="SemiBold" FontSize="24" TextTrimming="CharacterEllipsis" Foreground="#F3F0FF" />
                                <TextBlock x:Name="MenuDetail" FontFamily="ms-appx:///Assets/Fonts/Onest.ttf#Onest" FontSize="13" Foreground="#9A93BD" />
                            </StackPanel>
                        </Grid>

                        <Button x:Name="MenuResume" Style="{StaticResource MenuPrimary}" Click="MenuResume_Click" Padding="20,14">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE768;" FontSize="18" />
                                <TextBlock Text="Reprendre" FontSize="18" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="MenuBack" Style="{StaticResource MenuTile}" Click="MenuBack_Click">
                                <StackPanel Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE72B;" FontSize="16" Foreground="#B794FF" />
                                        <TextBlock Text="Revenir à Cartouche" FontSize="15" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Text="Le jeu continue sur le PC" FontSize="12" Foreground="#9A93BD" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="MenuQuit" Grid.Column="1" Style="{StaticResource MenuTile}" Click="MenuQuit_Click">
                                <StackPanel Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE7E8;" FontSize="16" Foreground="#FF8A9B" />
                                        <TextBlock Text="Quitter le jeu" FontSize="15" FontWeight="SemiBold" Foreground="#FFB3BE" />
                                    </StackPanel>
                                    <TextBlock Text="Il se ferme sur le PC" FontSize="12" Foreground="#9A93BD" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock Text="OUTILS" FontFamily="ms-appx:///Assets/Fonts/Onest.ttf#Onest" FontWeight="Bold" FontSize="12" CharacterSpacing="220" Foreground="#7F78A0" Margin="2,6,0,-6" />
                        <Grid ColumnSpacing="10" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Button x:Name="MenuMouse" Style="{StaticResource MenuTile}" Click="MenuMouse_Click" Padding="14,12">
                                    <StackPanel Spacing="8">
                                        <FontIcon Glyph="&#xE962;" FontSize="22" Foreground="#B794FF" HorizontalAlignment="Left" />
                                        <TextBlock Text="Souris" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="MenuMouseState" FontSize="12" Foreground="#9A93BD" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Grid Grid.Column="1">
                                <Button x:Name="MenuKeyboard" Style="{StaticResource MenuTile}" Click="MenuKeyboard_Click" Padding="14,12">
                                    <StackPanel Spacing="8">
                                        <FontIcon Glyph="&#xE92E;" FontSize="22" Foreground="#B794FF" HorizontalAlignment="Left" />
                                        <TextBlock Text="Clavier" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Grid Grid.Column="2">
                                <Button x:Name="MenuStats" Style="{StaticResource MenuTile}" Click="MenuStats_Click" Padding="14,12">
                                    <StackPanel Spacing="8">
                                        <FontIcon Glyph="&#xEC48;" FontSize="22" Foreground="#B794FF" HorizontalAlignment="Left" />
                                        <TextBlock Text="Stats" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="MenuStatsState" FontSize="12" Foreground="#9A93BD" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Grid Grid.Column="3">
                                <Button x:Name="MenuGuide" Style="{StaticResource MenuTile}" Click="MenuGuide_Click" Padding="14,12">
                                    <StackPanel Spacing="8">
                                        <FontIcon Glyph="&#xE7FC;" FontSize="22" Foreground="#B794FF" HorizontalAlignment="Left" />
                                        <TextBlock Text="Bouton Xbox" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Grid Grid.Row="1">
                                <Button x:Name="MenuPacing" Style="{StaticResource MenuTile}" Click="MenuPacing_Click" Padding="14,12">
                                    <StackPanel Spacing="8">
                                        <FontIcon Glyph="&#xE8B9;" FontSize="22" Foreground="#B794FF" HorizontalAlignment="Left" />
                                        <TextBlock Text="Rythme" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="MenuPacingState" FontSize="12" Foreground="#9A93BD" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Grid Grid.Row="1" Grid.Column="1">
                                <Button x:Name="MenuHdr" Style="{StaticResource MenuTile}" Click="MenuHdr_Click" Padding="14,12">
                                    <StackPanel Spacing="8">
                                        <FontIcon Glyph="&#xE706;" FontSize="22" Foreground="#B794FF" HorizontalAlignment="Left" />
                                        <TextBlock Text="HDR du PC" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Grid Grid.Row="1" Grid.Column="2">
                                <Button x:Name="MenuDecoder" Style="{StaticResource MenuTile}" Click="MenuDecoder_Click" Padding="14,12">
                                    <StackPanel Spacing="8">
                                        <FontIcon Glyph="&#xE72C;" FontSize="22" Foreground="#B794FF" HorizontalAlignment="Left" />
                                        <TextBlock Text="Relancer l'image" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Grid Grid.Row="1" Grid.Column="3">
                                <Button x:Name="MenuLogs" Style="{StaticResource MenuTile}" Click="MenuLogs_Click" Padding="14,12">
                                    <StackPanel Spacing="8">
                                        <FontIcon Glyph="&#xF0B5;" FontSize="22" Foreground="#B794FF" HorizontalAlignment="Left" />
                                        <TextBlock Text="Journal" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="MenuLogsState" FontSize="12" Foreground="#9A93BD" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>

                        <Grid Background="#0FFFFFFF" CornerRadius="16" Padding="18,14" RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="Tampon audio" FontFamily="ms-appx:///Assets/Fonts/Onest.ttf#Onest" FontSize="15" FontWeight="SemiBold" Foreground="#F3F0FF" />
                                <TextBlock Text="{Binding Value, ElementName=MenuBuffer}" FontFamily="ms-appx:///Assets/Fonts/Onest.ttf#Onest" FontSize="15" Foreground="#F2C14E" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="MenuBuffer" Grid.Row="1" Minimum="10" Maximum="50" StepFrequency="10" TickFrequency="10" SnapsTo="StepValues" UseSystemFocusVisuals="True" FocusVisualPrimaryBrush="#F2C14E" FocusVisualSecondaryThickness="0" Loaded="audioBufferSlider_Loaded" ValueChanged="audioBufferSlider_ValueChanged" PreviewKeyDown="audioBufferSliderItem_PreviewKeyDown" />
                            <TextBlock Grid.Row="2" Loaded="audioGlitchText_Loaded" FontFamily="ms-appx:///Assets/Fonts/Onest.ttf#Onest" FontSize="12" Foreground="#9A93BD" TextWrapping="Wrap" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="22" HorizontalAlignment="Right" Margin="0,2,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="24" Height="24" CornerRadius="12" Background="#3FA34D" BorderBrush="#5CC96B" BorderThickness="1">
                                    <TextBlock Text="A" FontFamily="ms-appx:///Assets/Fonts/Onest.ttf#Onest" FontWeight="Bold" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Choisir" FontFamily="ms-appx:///Assets/Fonts/Onest.ttf#Onest" FontSize="14" Foreground="#C9C2E6" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="24" Height="24" CornerRadius="12" Background="#D0383F" BorderBrush="#EF5E65" BorderThickness="1">
                                    <TextBlock Text="B" FontFamily="ms-appx:///Assets/Fonts/Onest.ttf#Onest" FontWeight="Bold" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Fermer" FontFamily="ms-appx:///Assets/Fonts/Onest.ttf#Onest" FontSize="14" Foreground="#C9C2E6" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>

</Page>
